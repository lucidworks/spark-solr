<solr>

  <str name="shareSchema">${shareSchema:false}</str>

  <!-- Solr 10's SolrXmlConfig.fillSolrCloudSection() hard-rejects any <solrcloud> parameter it
       doesn't recognize (hostContext, genericCoreNodeNames, distribUpdateConnTimeout, and
       distribUpdateSoTimeout were all removed), so this section is trimmed to the still-valid
       set: host, hostPort, zkClientTimeout. -->
  <solrcloud>
    <str name="host">127.0.0.1</str>
    <int name="hostPort">${hostPort:8983}</int>
    <int name="zkClientTimeout">${solr.zkclienttimeout:30000}</int>
  </solrcloud>

  <shardHandlerFactory name="shardHandlerFactory"
    class="HttpShardHandlerFactory">
    <str name="urlScheme">${urlScheme:}</str>
    <int name="socketTimeout">${socketTimeout:90000}</int>
    <int name="connTimeout">${connTimeout:15000}</int>
  </shardHandlerFactory>

  <metrics enabled="${metricsEnabled:false}"/>

</solr>

